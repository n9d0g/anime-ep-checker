{
  "name": "anime-ep-checker",
  "version": "1.0.0",
  "type": "module",
  "description": "Crunchyroll episode checker with Discord alerts",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "check": "tsx src/check.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["crunchyroll", "anime", "discord"],
  "author": "n9d0g",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.21",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
