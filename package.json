{
  "name": "anime-ep-checker",
  "version": "1.0.0",
  "type": "module",
  "description": "Crunchyroll, Netflix, and Disney+ episode checker with Discord alerts",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "check": "node --env-file-if-exists=.env src/check.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "merge-state": "node src/state-merge.ts",
    "test": "node --test 'src/**/*.test.ts' 'shared/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crunchyroll",
    "netflix",
    "disney",
    "anime",
    "discord",
    "mal"
  ],
  "author": "n9d0g",
  "license": "ISC",
  "engines": {
    "node": "26.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "oxfmt": "0.75.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
