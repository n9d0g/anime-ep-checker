{
  "name": "anime-ep-checker",
  "version": "1.0.0",
  "type": "module",
  "description": "Crunchyroll, Netflix, and Disney+ episode checker with Discord alerts",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "check": "node src/check.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "merge-state": "node src/state-merge.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crunchyroll",
    "netflix",
    "disney",
    "anime",
    "discord",
    "mal"
  ],
  "author": "n9d0g",
  "license": "ISC",
  "engines": {
    "node": "24.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "oxfmt": "0.72.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
