# Local: copy to admin/.env.local
# Production (after first GHA deploy): from admin/
#   npx wrangler secret put <NAME> --name anime-ep-checker-admin
ADMIN_PASSWORD=your-admin-password
# Signs the login session cookie (never contains the password). Any long random
# string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
ADMIN_SESSION_SECRET=your-random-session-secret
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-username/anime-ep-checker
GITHUB_BRANCH=main
# PAT needs Actions: Write for Add break to trigger forced checker runs

# MyAnimeList OAuth (see /mal in admin after deploy)
MAL_CLIENT_ID=your-mal-client-id
MAL_CLIENT_SECRET=your-mal-client-secret
MAL_REDIRECT_URI=https://anime-ep-checker.dev/api/mal/callback
# Optional: canonical admin URL for link previews (defaults to MAL_REDIRECT_URI origin)
# ADMIN_PUBLIC_URL=https://anime-ep-checker.dev
MAL_REFRESH_TOKEN=your-mal-refresh-token
