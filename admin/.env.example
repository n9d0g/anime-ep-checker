# Local: copy to admin/.env.local
# Production (after first GHA deploy): from admin/
#   npx wrangler secret put <NAME> --name anime-ep-checker-admin
ADMIN_PASSWORD=your-admin-password
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-username/anime-ep-checker
GITHUB_BRANCH=main
# PAT needs Actions: Write for Delay +1 week to trigger forced checker runs

# Discord interactions (MAL button) + optional dashboard refresh from admin
DISCORD_PUBLIC_KEY=your-discord-app-public-key
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_WATCHING_CHANNEL_ID=

# MyAnimeList OAuth (see /mal in admin after deploy)
MAL_CLIENT_ID=your-mal-client-id
MAL_CLIENT_SECRET=your-mal-client-secret
MAL_REDIRECT_URI=https://anime-ep-checker-admin.<your-subdomain>.workers.dev/api/mal/callback
# Optional: canonical admin URL for link previews (defaults to MAL_REDIRECT_URI origin)
# ADMIN_PUBLIC_URL=https://anime-ep-checker-admin.<your-subdomain>.workers.dev
MAL_REFRESH_TOKEN=your-mal-refresh-token
